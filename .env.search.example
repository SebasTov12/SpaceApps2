# Copia a .env.search y completa solo los valores que vayas a usar.
# Earthdata Login puede autenticarse mediante token o usuario/contraseña.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Descubrimiento y filtrado NISAR.
NISAR_ACCESS_MODE=https
NISAR_CATALOG=ASF
NISAR_PRODUCT_SHORT_NAME=
NISAR_AOI_PATH=./data/aoi/pilot.geojson
NISAR_START_DATE=
NISAR_END_DATE=
NISAR_DATA_DIR=./data/nisar
NISAR_FILTERED_DIR=./data/filtered

# Acceso directo a S3: credenciales STS temporales obtenidas con Earthdata.
# Solo funcionan para acceso S3 desde AWS us-west-2 y expiran en ~1 hora.
AWS_REGION=us-west-2
NISAR_S3_CREDENTIALS_ENDPOINT=https://nisar.asf.earthdatacloud.nasa.gov/s3credentials
NISAR_S3_BUCKET=sds-n-cumulus-prod-nisar-products
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_CREDENTIAL_EXPIRATION=
