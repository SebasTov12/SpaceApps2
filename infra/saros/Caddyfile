# Caddy emite y renueva el certificado TLS de saros.tobaru.xyz automáticamente.
# El registro DNS debe apuntar al servidor y los puertos 80/443 deben llegar a Caddy.
saros.tobaru.xyz {
	encode zstd gzip

	# The assistant route is a Next.js server endpoint. It adds the private
	# bearer token before forwarding the request to Flask.
	route {
		@assistant path /api/assistant
		reverse_proxy @assistant spaceapps2-saros:3000

		@api path /health /ready /api/v1/*
		reverse_proxy @api spaceapps2-api:8000

		reverse_proxy spaceapps2-saros:3000
	}
}
