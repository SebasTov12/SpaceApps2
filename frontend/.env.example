# Optional public API origin, without /api/v1.
# Server-side routes use SAROS_INTERNAL_API_URL for private backend access.
NEXT_PUBLIC_SAROS_API=

# Private, server-side model proxy. Keep disabled until the access key and session secret
# are configured in the private deployment environment (never in NEXT_PUBLIC_*).
SAROS_ENABLE_MODEL_ACTIONS=false
SAROS_MODEL_TOOLS_ACCESS_KEY=
SAROS_MODEL_TOOLS_SESSION_SECRET=
