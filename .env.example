# Archivo único para adquisición NISAR y entrenamiento, local o en AWS.
# Earthdata token es preferible; usuario/contraseña funcionan como alternativa.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Catálogo, consulta espacial/temporal y productos.
NISAR_CATALOG=ASF
NISAR_ACCESS_MODE=auto
NISAR_S3_CREDENTIALS_ENDPOINT=https://nisar.asf.earthdatacloud.nasa.gov/s3credentials
NISAR_S3_BUCKET=sds-n-cumulus-prod-nisar-products
AWS_REGION=us-west-2
NISAR_PRODUCT_SHORT_NAME=
NISAR_AOI_PATH=./data/aoi/pilot.geojson
NISAR_START_DATE=
NISAR_END_DATE=
NISAR_DATA_DIR=./data/nisar
NISAR_FILTERED_DIR=./data/filtered

# Opcional: credenciales STS de AWS solo si el proceso las obtiene fuera de earthaccess.
# Son temporales (aprox. 1 hora); no reutilizar valores vencidos.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_CREDENTIAL_EXPIRATION=

# Entrenamiento local o en instancia AWS. Usa los datos filtrados anteriores.
NISAR_LABELS_DIR=./data/labels
NISAR_MANIFEST=./data/filtered/manifest.parquet
ML_OUTPUT_DIR=./models/nisar-change
ML_FRAMEWORK=pytorch
ML_DEVICE=auto
ML_BATCH_SIZE=4
ML_EPOCHS=30
ML_RANDOM_SEED=42
ML_SPLIT_STRATEGY=spatiotemporal
