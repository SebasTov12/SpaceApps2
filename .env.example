# Archivo único para adquisición NISAR y entrenamiento, local o en AWS.
# Earthdata Login para earthaccess.login(strategy="environment").
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_AUTH_STRATEGY=environment

# Catálogo, consulta espacial/temporal y productos.
NISAR_CATALOG=ASF
NISAR_ACCESS_MODE=auto
NISAR_PROCESSING_LEVEL=GUNW
NISAR_S3_CREDENTIALS_ENDPOINT=https://nisar.asf.earthdatacloud.nasa.gov/s3credentials
NISAR_S3_BUCKET=sds-n-cumulus-prod-nisar-products
AWS_REGION=us-west-2
NISAR_PRODUCT_SHORT_NAME=
NISAR_DATA_MATURITY=
NISAR_AOI_PATH=./data/aoi/pilot.geojson
NISAR_START_DATE=
NISAR_END_DATE=
NISAR_DATA_DIR=./data/nisar
NISAR_FILTERED_DIR=./data/filtered
NISAR_COLOMBIA_BBOX=-82.5,-5,-66.5,14

# Stack SAROS: conserva la misma contraseña que ya usa el volumen existente
# spaceapps2_postgres_data en Orivia.
SAROS_POSTGRES_DB=spaceapps2
SAROS_POSTGRES_USER=spaceapps2_admin
SAROS_POSTGRES_PASSWORD=
SAROS_PREDICTION_TOKEN=
SAROS_API_PUBLIC_URL=https://saros.tobaru.xyz

# El worker solicita credenciales S3 STS temporales en runtime usando Earthdata.
# No guardar claves AWS permanentes ni copiar credenciales temporales aquí.

# Entrenamiento local con pares NISAR ya preparados y etiquetados.
# El manifiesto incluye sample_id, sample_path, split, spatial_group y temporal_group.
# Cada NPZ contiene before/after [canales, alto, ancho] y label [alto, ancho].
ML_MANIFEST=./data/filtered/manifest.parquet
ML_OUTPUT_DIR=./models/nisar-change
ML_FRAMEWORK=pytorch
ML_DEVICE=auto
ML_INPUT_CHANNELS=2
ML_BASE_CHANNELS=16
ML_BATCH_SIZE=4
ML_EPOCHS=30
ML_LEARNING_RATE=0.0003
ML_THRESHOLD=0.5
ML_RANDOM_SEED=42
ML_SPLIT_STRATEGY=spatiotemporal
ML_MAX_REQUEST_BYTES=33554432
ML_MAX_PIXELS=262144
