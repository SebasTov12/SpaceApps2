# NISAR acquisition, processing, and training settings.
# Earthdata Login for earthaccess.login(strategy="environment").
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_AUTH_STRATEGY=environment

# Catalog, spatial and temporal search, and product selection.
NISAR_CATALOG=ASF
NISAR_PROCESSING_LEVEL=GUNW
NISAR_PRODUCT_SHORT_NAME=
NISAR_DATA_MATURITY=
NISAR_START_DATE=
NISAR_END_DATE=
NISAR_FILTERED_DIR=./data/filtered
NISAR_COLOMBIA_BBOX=-82.5,-5,-66.5,14

# SAROS stack: keep the password already used by the existing
# spaceapps2_postgres_data volume on Orivia.
SAROS_POSTGRES_DB=spaceapps2
SAROS_POSTGRES_USER=spaceapps2_admin
SAROS_POSTGRES_PASSWORD=
SAROS_PREDICTION_TOKEN=
SAROS_ASSISTANT_TOKEN=
SAROS_REPORT_INTERVAL_SECONDS=86400
SAROS_API_PUBLIC_URL=https://saros.tobaru.xyz
SAROS_NISAR_DATA_HOST_PATH=../../data/nisar
# Keep false on the public site unless model actions are protected by application access control.
SAROS_ENABLE_MODEL_ACTIONS=false
# Private SAROS model-tools login; generate distinct random values for the server .env.
SAROS_MODEL_TOOLS_ACCESS_KEY=
SAROS_MODEL_TOOLS_SESSION_SECRET=

# Groq chat completions. Keep the API key only in the private local/server .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Earthdata credentials are used only by download processes.
# Never store secrets in Git or expose them to browser code.

# Local training on prepared and labeled NISAR pairs.
# The manifest contains sample_id, sample_path, split, spatial_group, and temporal_group.
# Each NPZ contains before/after [channels, height, width] and label [height, width].
ML_MANIFEST=./data/filtered/manifest.parquet
ML_OUTPUT_DIR=./models/nisar-change
ML_DEVICE=auto
ML_INPUT_CHANNELS=2
ML_BASE_CHANNELS=16
ML_BATCH_SIZE=4
ML_EPOCHS=30
ML_LEARNING_RATE=0.0003
ML_THRESHOLD=0.5
ML_RANDOM_SEED=42
ML_SPLIT_STRATEGY=spatiotemporal
ML_MAX_REQUEST_BYTES=33554432
ML_MAX_PIXELS=262144
